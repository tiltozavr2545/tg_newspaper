# Скопировать в .env и заполнить реальными значениями. .env в репозиторий не коммитить.

# my.telegram.org -> API development tools, под вспомогательным аккаунтом проекта
TG_API_ID=
TG_API_HASH=

# Имя файла сессии Telethon (создаётся при первом интерактивном логине).
# Сам файл сессии — секрет, в репозиторий не коммитится (см. .gitignore).
TG_SESSION_NAME=tg_newspaper

# ===== Gemini (LLM-классификация спорных постов, Этап 2 п.2) =====
# API-ключ из Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Модель (бесплатный тариф)
GEMINI_MODEL=gemini-2.5-flash
# (необязательно) Прокси к Gemini через свой Cloudflare Worker — нужен, если Gemini
# отдаёт ошибку "User location is not supported" (агент работает из РФ).
# Деплой воркера — см. cloudflare-worker.js и README, раздел "Обход гео-блокировки".
# Пример: https://tg-newspaper-gemini.ТВОЙ-АККАУНТ.workers.dev
GEMINI_BASE_URL=
