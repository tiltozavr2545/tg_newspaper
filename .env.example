# Copy to .env and fill in real values. Do not commit .env to the repository.

# my.telegram.org -> API development tools, under the project's helper account
TG_API_ID=
TG_API_HASH=

# Telethon session file name (created on first interactive login).
# The session file itself is a secret and is not committed to the repo (see .gitignore).
TG_SESSION_NAME=tg_newspaper

# ===== Gemini (LLM classification of borderline posts, Stage 2 item 2) =====
# API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model (free tier)
GEMINI_MODEL=gemini-3.5-flash-lite
# (REQUIRED) Proxy to Gemini through your own Cloudflare Worker — the agent runs from Russia,
# and Gemini returns "User location is not supported" when hit directly. The setup wizard won't finish without it.
# Worker deployment — see cloudflare-worker.js and the README, "Bypassing the geo-block" section.
# Example: https://tg-newspaper-gemini.YOUR-ACCOUNT.workers.dev
GEMINI_BASE_URL=
